{
  "name": "stream-live",
  "version": "1.8.5",
  "description": "Stream Live desktop app - real-time AI webcam transformation. Account-gated: all AI keys are served by the STREAM LIVE gateway, the user never enters one.",
  "main": "dist-electron/main.js",
  "author": "Rich Life Technologies",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --watch dist/index.html --exec 'electron .'\"",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "preview": "vite preview",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64"
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.10",
    "@msgpack/msgpack": "^3.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "koffi": "^2.9.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "build": {
    "appId": "com.richlife.streamlive",
    "productName": "Stream Live",
    "copyright": "Copyright © 2025 Rich Life Technologies",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/koffi/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "StreamLive-Setup-${version}.exe",
      "extraFiles": [
        {
          "from": "drivers",
          "to": "drivers",
          "filter": [
            "*.exe",
            "*.nsh",
            "*.md",
            "*.ps1",
            "**/*.dll",
            "**/*.exe",
            "**/*.ps1",
            "**/*.md"
          ]
        },
        {
          "from": "drivers/vbcable",
          "to": "drivers/vbcable",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "public/installer-sidebar.bmp",
      "uninstallerSidebar": "public/installer-sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stream Live",
      "displayLanguageSelector": false,
      "include": "drivers/install-drivers.nsh",
      "warningsAsErrors": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.video",
      "artifactName": "StreamLive-${version}-${arch}.dmg",
      "minimumSystemVersion": "11.0",
      "identity": null,
      "notarize": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Stream Live needs your camera so the AI can transform your video live. The frames are only used while you are on air.",
        "NSMicrophoneUsageDescription": "Stream Live needs your microphone to capture your voice and clone it in real time."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Video",
      "artifactName": "StreamLive-${version}.AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "richlifetechnologies-lang",
      "repo": "stream-live"
    }
  }
}
